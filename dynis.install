post_install() {
  echo ":: Dynis has been installed."
  echo ":: To start the island and enable it on login, run:"
  echo "   systemctl --user enable --now dynis"
  echo ""
  echo ":: Alternatively, add this to your hyprland.conf:"
  echo "   exec-once = dynis"
}

post_upgrade() {
  echo ":: Dynis has been updated. Restart it from your graphical session:"
  echo "   systemctl --user daemon-reload"
  echo "   systemctl --user restart dynis"
  echo ":: If started with exec-once, restart Dynis manually or log in again."
}
